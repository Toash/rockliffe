---
import NorthwindApp from "../components/NorthwindApp.vue";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Northwind Orders Portal</title>
  </head>
  <body
    style="font-family: system-ui; margin: 0; background: #f9fafb; color: #1f2937; min-height: 100vh;"
  >
    <main style="max-width: 1200px; margin: 0 auto; padding: 2rem;">
      <section style="margin-bottom: 2rem;">
        <h1
          style="font-size: 2rem; font-weight: 600; margin-bottom: 0.5rem; color: #111827;"
        >
          Northwind Orders Portal
        </h1>
        <p style="color: #6b7280; max-width: 40rem; font-size: 0.875rem;">
          Log in as a Northwind employee to explore your orders and drill into
          product details.
        </p>
      </section>

      <NorthwindApp client:load />
    </main>
  </body>
</html>
